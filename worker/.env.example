SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=sb_secret_...
# Chỉ script nạp nhạc mẫu (supabase/seed/seed.ts) dùng: đăng nhập như admin để gọi review_song
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Python có cài visqol-python (đo PSL). Để trống: bỏ qua PSL, dựng thang mặc định 64/128/256.
PSL_PYTHON=.venv/bin/python
# Cloudflare R2 (chương 23). Để trống: file âm thanh lưu ở Supabase Storage.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=hugo-music-audio
